# StayWU Server Environment Configuration
PORT=3001

# Google Gemini API Keys (Primary + Backup with Auto-Failover)
GEMINI_API_KEY=your_primary_gemini_api_key
GEMINI_API_KEY_BACKUP=your_backup_gemini_api_key

# Telegram Concierge Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=StayWU_bot

# Production Frontend URL (e.g. your Vercel deployment URL)
FRONTEND_URL=https://staywu.vercel.app

# Allowed CORS Origins (* or your Vercel domain)
CORS_ORIGIN=*
